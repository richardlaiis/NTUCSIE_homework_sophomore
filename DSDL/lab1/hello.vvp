#! /usr/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0-dirty)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/ivl/system.vpi";
:vpi_module "/usr/lib/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/ivl/va_math.vpi";
S_0x55776d640920 .scope module, "hello" "hello" 2 1;
 .timescale 0 0;
L_0x55776d662a20/d .functor NOT 1, v0x55776d6628c0_0, C4<0>, C4<0>, C4<0>;
L_0x55776d662a20 .delay 1 (3,3,3) L_0x55776d662a20/d;
v0x55776d640ab0_0 .var/i "i", 31 0;
v0x55776d6628c0_0 .var "in", 0 0;
v0x55776d662980_0 .net "out", 0 0, L_0x55776d662a20;  1 drivers
    .scope S_0x55776d640920;
T_0 ;
    %vpi_call 2 7 "$display", "time / in out" {0 0 0};
    %vpi_call 2 8 "$monitor", "%d / %b %b", $time, v0x55776d6628c0_0, v0x55776d662980_0 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x55776d640ab0_0, 0, 32;
T_0.0 ; Top of for-loop
    %load/vec4 v0x55776d640ab0_0;
    %cmpi/s 5, 0, 32;
	  %jmp/0xz T_0.1, 5;
    %vpi_call 2 10 "$display", "----------" {0 0 0};
    %load/vec4 v0x55776d640ab0_0;
    %pad/s 1;
    %assign/vec4 v0x55776d6628c0_0, 0;
    %delay 10, 0;
T_0.2 ; for-loop step statement
    %load/vec4 v0x55776d640ab0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55776d640ab0_0, 0, 32;
    %jmp T_0.0;
T_0.1 ; for-loop exit label
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 3;
    "N/A";
    "<interactive>";
    "hello.v";
