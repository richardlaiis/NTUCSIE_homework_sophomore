    \PYG{n+nb}{fprintf}\PYG{p}{(}\PYG{l+s}{\PYGZsq{}For n=\PYGZpc{}d: Vectorized = \PYGZpc{}f s, One\PYGZhy{}loop = \PYGZpc{}f s, Two\PYGZhy{}loop = \PYGZpc{}f s\PYGZbs{}n\PYGZsq{}}\PYG{p}{,} \PYG{n}{n}\PYG{p}{,} \PYG{n}{time\PYGZus{}vec}\PYG{p}{,} \PYG{n}{time\PYGZus{}one}\PYG{p}{,} \PYG{n}{time\PYGZus{}two}\PYG{p}{);}
\PYG{k}{end}
