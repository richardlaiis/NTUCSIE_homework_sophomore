\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{n}{n\PYGZus{}values} \PYG{p}{=} \PYG{p}{[}\PYG{l+m+mi}{10}\PYG{p}{,} \PYG{l+m+mi}{100}\PYG{p}{,} \PYG{l+m+mi}{1000}\PYG{p}{,} \PYG{l+m+mi}{4000}\PYG{p}{];} 

\PYG{k}{for} \PYG{n}{n} \PYG{p}{=} \PYG{n}{n\PYGZus{}values}
    \PYG{n}{A} \PYG{p}{=} \PYG{n}{generate\PYGZus{}spd}\PYG{p}{(}\PYG{n}{n}\PYG{p}{);} 
    
    \PYG{c}{\PYGZpc{} Measure Vectorized Version}
